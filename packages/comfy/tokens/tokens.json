{
  "$description": "cozy design tokens, from the Figma file 'cozy design system' (Design Guide page). Format: W3C Design Tokens (DTCG).",
  "color": {
    "$type": "color",
    "palette": {
      "white": { "$value": "#FFFDFA", "$description": "cozy white" },
      "grey": { "$value": "#C4C4C4", "$description": "cozy grey" },
      "smoke": { "$value": "#696D73", "$description": "cozy smoke" },
      "black": { "$value": "#494949", "$description": "cozy black" },
      "pink": { "$value": "#F792BE", "$description": "cozy pink" },
      "peach": { "$value": "#FFB9A6", "$description": "cozy peach" },
      "hot": { "$value": "#D92D6B", "$description": "cozy hot" },
      "blue": { "$value": "#58A2C1", "$description": "cozy blue" },
      "deep": { "$value": "#2B6484", "$description": "cozy deep" },
      "ice": { "$value": "#76E3DD", "$description": "cozy ice" }
    },
    "dark": {
      "background": { "$value": "{color.palette.black}" },
      "text": { "$value": "{color.palette.white}" },
      "text-muted": { "$value": "{color.palette.grey}" },
      "accent": { "$value": "{color.palette.pink}" },
      "foreground": { "$value": "{color.palette.peach}" },
      "action": { "$value": "{color.palette.hot}" },
      "alert": { "$value": "{color.palette.ice}", "$description": "Not defined for dark in Figma; borrowed from light." }
    },
    "light": {
      "background": { "$value": "{color.palette.white}" },
      "text": { "$value": "{color.palette.black}" },
      "text-muted": { "$value": "{color.palette.smoke}" },
      "accent": { "$value": "{color.palette.blue}" },
      "foreground": { "$value": "{color.palette.deep}" },
      "action": { "$value": "{color.palette.hot}", "$description": "Not defined for light in Figma; borrowed from dark." },
      "alert": { "$value": "{color.palette.ice}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "heading": { "$value": ["Montserrat Alternates", "sans-serif"] },
    "display": { "$value": ["Dosis", "sans-serif"] },
    "body": { "$value": ["Open Sans", "sans-serif"] }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.display}", "fontWeight": 800, "fontSize": "128px", "lineHeight": "105px", "textTransform": "lowercase" } },
    "subheading": { "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "32px", "textTransform": "lowercase" } },
    "subheading-alt": { "$value": { "fontFamily": "{font.display}", "fontWeight": 200, "fontSize": "32px", "textTransform": "lowercase" } },
    "h1": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 800, "fontSize": "64px" }, "$description": "Page title" },
    "h1-alt": { "$value": { "fontFamily": "{font.body}", "fontWeight": 300, "fontSize": "64px" }, "$description": "Supportive tagline" },
    "h2": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 800, "fontSize": "40px" }, "$description": "Section heading" },
    "h2-alt": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 300, "fontSize": "40px" } },
    "h3": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 800, "fontSize": "32px" }, "$description": "Paragraph heading" },
    "h3-alt": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 300, "fontSize": "32px" } },
    "h4": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 800, "fontSize": "20px" }, "$description": "Block heading" },
    "h5": { "$value": { "fontFamily": "{font.heading}", "fontWeight": 800, "fontSize": "16px" }, "$description": "Small important heading" },
    "body": { "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "16px" } },
    "body-bold": { "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "16px" } }
  },
  "layout": {
    "desktop-columns": { "$type": "number", "$value": 12 },
    "desktop-min-width": { "$type": "dimension", "$value": "800px" }
  }
}
