# Server
PORT=8787
# Leave unset to use an embedded Postgres (PGlite) stored in apps/server/.pglite.
# Set to use real Postgres (see docker-compose.yml):
# DATABASE_URL=postgres://cozy:comfy123@localhost:5432/cozy

# Event sources. The seed source is always on; others turn on when their key is set.
# https://developer.ticketmaster.com/ (free, 5000 calls/day)
TICKETMASTER_API_KEY=
# Minutes between ingestion runs
INGEST_INTERVAL_MIN=15

# Web (Vite)
VITE_API_URL=http://localhost:8787
