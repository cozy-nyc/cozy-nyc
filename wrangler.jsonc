{
  // Cloudflare Workers Builds config: serves the built web app as static assets.
  // Build: pnpm run build   Deploy: npx wrangler deploy   (see docs/DEPLOY.md)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cozy-nyc",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  }
}
